FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FALCON_STATE_DIR=/data

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system falcon \
    && useradd --system --gid falcon --create-home falcon

COPY requirements-falcon.txt ./requirements-falcon.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-falcon.txt

COPY falcon ./falcon
COPY forgeml ./forgeml

RUN mkdir -p /data && chown -R falcon:falcon /app /data
USER falcon

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import json,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)); assert 'status' in d"

CMD ["python", "-m", "falcon.cli", "--state-dir", "/data", "serve", "--host", "0.0.0.0", "--port", "8080"]
